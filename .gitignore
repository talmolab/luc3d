# Local CDN fallback (NOT committed; kept on disk in case jsdelivr's +esm /
# redirect endpoints loop again and hang init). To recover, repoint the CDN
# imports at these local copies:
#   index.html        dockview.css link  -> lib/dockview-core/dockview.css
#   index.html        importmap "yaml"   -> ./lib/yaml/browser/index.js
#   ui/sessions-panes.js  dockview +esm  -> ../lib/dockview-core/main.esm.mjs
#   loading/frame-worker.js + slp-import-worker.js  h5wasm +esm -> ../lib/h5wasm/hdf5_hl.js
# Re-fetch instructions live in each dir's PROVENANCE.txt. (lib/h5wasm and
# lib/sleap-io are committed; only these two vendored fallbacks are ignored.)
lib/dockview-core/
lib/yaml/

# Bench driver node deps (not part of the served app)
scripts/bench/node_modules/

# sleap-io.js re-vendor build dir (scripts/revendor-sleap-io.sh default work-dir)
.sleap-io-build/
_bugdata
_real-roundtrip-*.slp
# sequence-workflow harness fixtures/outputs (tests/e2e/sequence-lazy-workflow.mjs)
_seq-*.slp

# Paper figures (figs/). Layout follows talmolab/figures-mimic-mjx:
#   figs/panels/   one script per panel                     TRACKED
#   figs/src/      shared style + loaders                   TRACKED
#   figs/data/     small plot-ready CSVs, one per panel     TRACKED  <- deliberately
#   figs/figures/  the rendered panel PDFs + composites     TRACKED  <- deliberately
#   figs/out/      the raw measurement deposits + app PNGs  ignored (large, machine-local)
#   figs/session/  trimmed multi-camera clip, rebuilt by build_fig_session.py
#
# data/ and figures/ ARE tracked so the figures are buildable and auditable from a
# fresh clone without re-running the measurement pass (which needs the bench env and
# the raw corpora). That is the reference repo's idiom: the expensive pass deposits,
# the plotting pass reads a committed table.
figs/session/
figs/out/
figs/node_modules
figs/.venv/
figs/__pycache__/
figs/**/__pycache__/
!figs/*.md
!figs/data/**
!figs/figures/**
# ...EXCEPT the manuscript-writing documents, UNTRACKED since 2026-08-26 (Eric:
# "remove all of these md and txt files for writing methods, results, captions
# figure legends etc from the eric/figs branch ... but make them untracked").
# The manuscript text's canonical home is figures/drafts/*.tex; these live on
# as local working copies only (last tracked state: the commit before this
# rule landed). make_docs.py skips their .txt twins when the .md is absent.
figs/CAPTIONS.md
figs/FIGURE-LEGENDS*.md
figs/FIGURE-LEGENDS.txt
figs/METHODS*.md
figs/METHODS.txt
figs/RESULTS*.md
figs/RESULTS.txt
figs/FIGURES-PLAIN-ENGLISH.md
figs/FRESH-ANCHOR.md
figs/FRESH-ANCHOR.txt
