# Offline dependencies: the four packages the app normally streams from jsdelivr.
# Declared in offline-deps.json, fetched on demand, never committed:
#     python3 scripts/offline_deps.py install
# Each directory keeps its own .gitignore + PROVENANCE.txt tracked, so lib/
# documents what belongs there even when the payload is absent. Do NOT repoint
# index.html or the ui/ imports at these by hand -- `server.py --offline` rewrites
# them as it serves, and `offline_deps.py bundle` rewrites them in a zip.
# (lib/h5wasm, lib/sleap-io, lib/mediabunny and lib/pako are committed.)
lib/dockview-core/*
!lib/dockview-core/.gitignore
!lib/dockview-core/PROVENANCE.txt
lib/yaml/*
!lib/yaml/.gitignore
!lib/yaml/PROVENANCE.txt
lib/three/*
!lib/three/.gitignore
!lib/three/PROVENANCE.txt
lib/mp4box/*
!lib/mp4box/.gitignore
!lib/mp4box/PROVENANCE.txt

# Offline bundles built by `offline_deps.py bundle`
luc3d-offline-*.zip

# Bench driver node deps (not part of the served app)
scripts/bench/node_modules/

# sleap-io.js re-vendor build dir (scripts/revendor-sleap-io.sh default work-dir)
.sleap-io-build/
_bugdata
_real-roundtrip-*.slp
# sequence-workflow harness fixtures/outputs (tests/e2e/sequence-lazy-workflow.mjs)
_seq-*.slp
