<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the macOS bundle's Info.plist by Tauri. The menu bar's bold
	     app name comes from CFBundleName, not from the app submenu's text, so it is
	     set here. productName (the .app file, binary and installer names) stays
	     "luc3d", so updates and installs are unaffected. -->
	<key>CFBundleName</key>
	<string>LUC3D</string>
	<key>CFBundleDisplayName</key>
	<string>LUC3D</string>
</dict>
</plist>
